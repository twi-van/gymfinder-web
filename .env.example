# =============================================================================
# GYMFINDER — mẫu biến môi trường
# Copy thành file `.env` ở thư mục gốc dự án rồi điền giá trị.
# KHÔNG commit file `.env` (đã có trong .gitignore).
#
# Thứ tự ưu tiên cấu hình:
#   1) Biến môi trường hệ thống / Railway Variables
#   2) File `.env`
#   3) backend/ai.local.php , backend/smtp.local.php
#   4) Mặc định trong backend/config.php
# =============================================================================

# --- Database (MySQL) ---
GF_DB_DRIVER=mysql
GF_DB_HOST=127.0.0.1
GF_DB_PORT=3306
GF_DB_NAME=gymfinder
GF_DB_USER=root
GF_DB_PASS=

# --- Trợ lý AI (Groq) ---
GF_AI_ENABLED=true
GF_AI_PROVIDER=groq
GF_AI_API_KEY=
GF_AI_MODEL=qwen/qwen3.8-27b
GF_AI_BASE_URL=

# --- SMTP / Quên mật khẩu OTP ---
# demo_otp=true → hiện OTP trên UI, không gửi mail
GF_SMTP_DEMO_OTP=true
GF_SMTP_HOST=smtp.gmail.com
GF_SMTP_PORT=587
GF_SMTP_ENCRYPTION=tls
GF_SMTP_USERNAME=
GF_SMTP_PASSWORD=
GF_SMTP_FROM_EMAIL=
GF_SMTP_FROM_NAME=GYMFINDER

# --- Đăng nhập Google (OAuth) ---
# Tạo OAuth Client (Web) tại Google Cloud Console.
# Authorized redirect URI phải trùng đúng URL callback, ví dụ:
#   https://gymfinder-wed.up.railway.app/pages/auth/google_callback.php
#   http://localhost/GYMFINDER/pages/auth/google_callback.php
GF_GOOGLE_CLIENT_ID=
GF_GOOGLE_CLIENT_SECRET=
